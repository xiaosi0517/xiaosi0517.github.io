<a class="featured-project card hoverable" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
  {% if project.img %}
    <div class="featured-project-visual">
      <img
        src="{{ project.img | relative_url }}"
        alt="{{ project.img_alt | default: project.title }}"
        loading="eager"
      >
    </div>
  {% endif %}
  <div class="featured-project-copy card-body">
    <h3 class="card-title">{{ project.title }}</h3>
    {% if project.tech %}
      <p class="featured-project-tags">
        {% for item in project.tech %}{{ item }}{% unless forloop.last %} · {% endunless %}{% endfor %}
      </p>
    {% endif %}
    <p class="card-text">{{ project.description }}</p>
  </div>
</a>
