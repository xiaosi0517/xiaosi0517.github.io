---
layout: default
---

{% assign basics = site.data.resume.basics %}
{% assign work_entries = site.data.resume.work | default: empty %}
{% assign education_entries = site.data.resume.education | default: empty %}
{% assign publication_entries = site.data.resume.publications | default: empty %}
{% assign award_entries = site.data.resume.awards | default: empty %}
{% assign language_entries = site.data.resume.languages | default: empty %}

<div class="post cv-modern">
  <header class="cv-modern-header">
    <h1>{{ page.title }}</h1>
    {% if page.description %}
      <p>{{ page.description }}</p>
    {% endif %}
  </header>

  <article class="cv-modern-grid">
    <section class="cv-photo-panel" aria-label="Profile photo">
      <img src="{{ basics.image | default: '/assets/img/prof_pic.jpg' }}" alt="Portrait of {{ basics.name | default: 'Xiaosi Zhang' }}">
    </section>

    <section class="cv-card cv-contact-card">
      <div class="cv-section-title">
        <span class="cv-icon"><i class="fas fa-user"></i></span>
        <h2>Contact Information</h2>
      </div>
      <dl class="cv-contact-list">
        <div>
          <dt><i class="fas fa-user"></i>Name</dt>
          <dd>{{ basics.name | default: "Xiaosi Zhang" }}</dd>
        </div>
        <div>
          <dt><i class="fas fa-briefcase"></i>Professional Title</dt>
          <dd>{{ basics.label | default: "Senior Software Systems Engineer" }}</dd>
        </div>
        <div>
          <dt><i class="fas fa-envelope"></i>Email</dt>
          <dd><a href="mailto:xiaosizhang0517@gmail.com">xiaosizhang0517@gmail.com</a></dd>
        </div>
        <div>
          <dt><i class="fas fa-location-dot"></i>Location</dt>
          <dd>
            {% if basics.location.city %}{{ basics.location.city }}{% else %}San Jose{% endif %}{% if basics.location.region %}, {{ basics.location.region }}{% endif %}
          </dd>
        </div>
        <div>
          <dt><i class="fas fa-link"></i>Website</dt>
          <dd><a href="https://xiaosi0517.github.io/">xiaosi0517.github.io</a></dd>
        </div>
        <div>
          <dt><i class="fab fa-github"></i>GitHub</dt>
          <dd><a href="https://github.com/xiaosi0517">github.com/xiaosi0517</a></dd>
        </div>
        <div>
          <dt><i class="fab fa-linkedin"></i>LinkedIn</dt>
          <dd><a href="https://www.linkedin.com/in/xiaosi-zhang-97948a201/">linkedin.com/in/xiaosi-zhang</a></dd>
        </div>
      </dl>
    </section>

    <section class="cv-card cv-summary-card">
      <div class="cv-section-title">
        <span class="cv-icon"><i class="fas fa-file-lines"></i></span>
        <h2>Professional Summary</h2>
      </div>
      <p>{{ basics.summary }}</p>
      <div class="cv-skill-tags">
        <span>Computer Vision</span>
        <span>Machine Learning</span>
        <span>System Design</span>
        <span>Semiconductor</span>
        <span>Image Processing</span>
        <span>Data Pipeline</span>
      </div>
    </section>

    {% if work_entries.size > 0 %}
      <section class="cv-card cv-wide-card">
        <div class="cv-section-title">
          <span class="cv-icon"><i class="fas fa-briefcase"></i></span>
          <h2>Experience</h2>
        </div>
        <div class="cv-timeline">
          {% for job in work_entries %}
            {% assign start_year = job.startDate | split: "-" | first %}
            {% assign end_year = job.endDate | split: "-" | first %}
            <article class="cv-timeline-item">
              <div class="cv-date-col">
                <span class="cv-dot"></span>
                <span class="cv-date-pill">{{ start_year }} - {% if job.endDate and job.endDate != "" %}{{ end_year }}{% else %}Present{% endif %}</span>
                {% if job.location %}
                  <span class="cv-location"><i class="fas fa-location-dot"></i>{{ job.location }}</span>
                {% endif %}
              </div>
              <div class="cv-timeline-copy">
                <h3>
                  {% if job.url %}
                    <a href="{{ job.url }}">{{ job.position }}</a>
                  {% else %}
                    {{ job.position }}
                  {% endif %}
                </h3>
                <p class="cv-organization">{{ job.name }}</p>
                {% if job.summary %}
                  <p class="cv-entry-summary">{{ job.summary }}</p>
                {% endif %}
                {% if job.projects %}
                  {% for project in job.projects %}
                    <div class="cv-project-block">
                      <h4>{{ project.name }}{% if project.dates %}<span>{{ project.dates }}</span>{% endif %}</h4>
                      <ul>
                        {% for item in project.highlights limit: 3 %}
                          <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endfor %}
                {% elsif job.highlights %}
                  <ul>
                    {% for item in job.highlights %}
                      <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if education_entries.size > 0 %}
      <section class="cv-card cv-wide-card">
        <div class="cv-section-title">
          <span class="cv-icon"><i class="fas fa-graduation-cap"></i></span>
          <h2>Education</h2>
        </div>
        <div class="cv-timeline compact">
          {% for education in education_entries %}
            {% assign start_year = education.startDate | split: "-" | first %}
            {% assign end_year = education.endDate | split: "-" | first %}
            <article class="cv-timeline-item">
              <div class="cv-date-col">
                <span class="cv-dot"></span>
                <span class="cv-date-pill">{{ start_year }} - {{ end_year }}</span>
              </div>
              <div class="cv-timeline-copy">
                <h3>
                  {% if education.url %}
                    <a href="{{ education.url }}">{{ education.institution }}</a>
                  {% else %}
                    {{ education.institution }}
                  {% endif %}
                </h3>
                <p>{{ education.studyType }} in {{ education.area }}</p>
                {% if education.score %}
                  <p class="cv-entry-summary">GPA: {{ education.score }}</p>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if publication_entries.size > 0 %}
      <section class="cv-card cv-wide-card cv-publications-card">
        <div class="cv-section-title cv-section-title-with-link">
          <span class="cv-icon"><i class="fas fa-file-lines"></i></span>
          <h2>Publications</h2>
        </div>
        <div class="cv-publication-list">
          {% for publication in publication_entries %}
            {% assign publication_year = publication.releaseDate | split: "-" | first %}
            <article class="cv-publication-item">
              <span class="cv-publication-index">{{ forloop.index }}</span>
              <div class="cv-publication-copy">
                <h3>{{ publication.name }}</h3>
                <p>{{ publication.authors }}</p>
                <p><em>{{ publication.publisher }}</em>{% if publication_year %} ({{ publication_year }}){% endif %}{% if publication.summary %} · {{ publication.summary }}{% endif %}</p>
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <section class="cv-card cv-wide-card">
      <div class="cv-section-title">
        <span class="cv-icon"><i class="fas fa-award"></i></span>
        <h2>Highlights</h2>
      </div>
      <div class="cv-highlight-list">
        {% for award in award_entries %}
          <article>
            <h3>{{ award.title }}</h3>
            <p>{{ award.awarder }}{% if award.summary %} · {{ award.summary }}{% endif %}</p>
          </article>
        {% endfor %}
        {% if language_entries.size > 0 %}
          <article>
            <h3>Languages</h3>
            <p>
              {% for language in language_entries %}
                {{ language.language }}{% if language.fluency %} ({{ language.fluency }}){% endif %}{% unless forloop.last %} · {% endunless %}
              {% endfor %}
            </p>
          </article>
        {% endif %}
      </div>
    </section>
  </article>
</div>
